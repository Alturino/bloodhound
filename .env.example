TZ="Asia/Jakarta"
PGTZ="Asia/Jakarta"

POSTGRES_DB=bloodhound
POSTGRES_HOST=postgres
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=bloodhound
POSTGRES_PORT=5432
POSTGRES_MIGRATION_PATH="file://db/migrations"
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"

POSTGRES_BLOODHOUND_PDF_EXTRACTOR_USER=bloodhound_pdf_extractor
POSTGRES_BLOODHOUND_PDF_EXTRACTOR_PASSWORD=bloodhound_pdf_extractor

# minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_VOLUMES=/mnt/minio/data
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_UI_PORT=9000
MINIO_CONSOLE_PORT=9001
